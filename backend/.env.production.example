# ==============================================================================
# TradeSathi AI — Production Environment Configuration Template
# ==============================================================================
# NOTE: This file is a template with placeholders only. Never commit real credentials
# or production secrets to source control. Copy to .env in your isolated production
# environment and populate with secure, high-entropy values.
# ==============================================================================

# Application Environment ('production' enforces strict security validations at startup)
ENVIRONMENT=production

# Server Host and Port (Must bind strictly to loopback behind a reverse proxy)
HOST=127.0.0.1
PORT=8000

# Cryptographic and JWT Session Secret Key (Minimum 32 characters, high entropy)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRADESATHI_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_HEX_SECRET_MIN_32_CHARS

# Cross-Origin Resource Sharing (CORS)
# MUST specify exact production domain(s). Wildcards (*) are strictly rejected in production.
CORS_ORIGINS=https://tradesathi.yourdomain.com

# File Upload Limit (in Megabytes)
MAX_UPLOAD_MB=10

# Database and Storage Configuration (Optional overrides; defaults to backend/tradesathi.db and backend/storage/documents)
# TRADESATHI_DB_PATH=/var/lib/tradesathi/tradesathi.db
# TRADESATHI_STORAGE_PATH=/var/lib/tradesathi/storage/documents
# TRADESATHI_BACKUP_ROOT=/var/backups/tradesathi

# Test Simulator Bypass (MUST be 0 or unset in production; startup fails if 1)
TRADESATHI_TEST_ROLE_SIMULATOR=0

# ==============================================================================
# Optional Outbound Email Transport (SMTP)
# Default is disabled (EMAIL_DELIVERY_ENABLED=false).
# ==============================================================================
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=tradesathi-notifications@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_SECURE_SMTP_PASSWORD
SMTP_FROM_EMAIL=TradeSathi Notifications <noreply@yourdomain.com>
SMTP_USE_TLS=true

# ==============================================================================
# Optional Local AI Inference (Ollama)
# If unreachable, TradeSathi operates deterministically via rule-based extraction.
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
