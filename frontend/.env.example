# Leave empty for local development; Vite proxies /api to FastAPI on backend port.
# If your backend runs on a non-standard port (e.g. 8001 instead of 8000), set:
# VITE_BACKEND_PORT=8001
# Or explicitly configure backend proxy target:
# VITE_BACKEND_URL=http://127.0.0.1:8001
# For direct API calls or hosted deployments, configure:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
VITE_BACKEND_PORT=8000
